# ==============================================================================
# SmartCondo Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# --- Server Runtime ---
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
API_BASE_PATH=/api/v1
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8080

# --- Database Configuration ---
POSTGRES_USER=smartcondo
POSTGRES_PASSWORD=replace-with-a-secure-password
POSTGRES_DB=smartcondo
DATABASE_URL=postgresql://smartcondo:replace-with-a-secure-password@localhost:5432/smartcondo
DATABASE_URL_DOCKER=postgresql://smartcondo:replace-with-a-secure-password@db:5432/smartcondo

# --- Security & JWT Authentication ---
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# --- Optional One-time Bootstrap Admin ---
# Set these only when running `npm run db:bootstrap-admin` for the first time.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

# --- SePay Payment Gateway (External API) ---
SEPAY_API_URL=
SEPAY_WEBHOOK_URL=
SEPAY_AES_SECRET_KEY=SePaySecretKey2026
SEPAY_BANK_CODE=ICB
SEPAY_ACCOUNT_NUMBER=10188999999
SEPAY_ACCOUNT_NAME=TRAN VAN TIEN
