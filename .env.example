NODE_ENV=development
HOST=127.0.0.1
PORT=3000
API_BASE_PATH=/api/v1
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
DATABASE_URL=postgresql://smartcondo:change-me@localhost:5432/smartcondo
DATABASE_URL_DOCKER=postgresql://smartcondo:change-me-local-only@db:5432/smartcondo
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
POSTGRES_USER=smartcondo
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=smartcondo
# Set these only for the one-time administrator bootstrap, then remove them.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=
